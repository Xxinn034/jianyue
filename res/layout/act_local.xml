<?xml version="1.0" encoding="utf-8"?>
<!--
  本地导入 (local imports) - tab 3 of 3.

  Only books that were imported off the card are listed here (their sourceUrl is
  local://local); online books live on the 书架 page. The + sits at the right of the top bar,
  as asked: when the page is empty the middle says 可以点击加号来添加本地图书.

  Bottom: the shared tab bar 书架 / 书源 / 本地导入 (see Ui.tabs).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- top bar: title + count + add -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingLeft="14dip"
        android:paddingRight="8dip"
        android:paddingTop="7dip"
        android:paddingBottom="7dip">

        <TextView
            android:id="@+id/local_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:text="本地导入" />

        <TextView
            android:id="@+id/local_count"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dip"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:text="" />

        <!--
          Leaves selection mode. It sits in the top row (like the 书源 page's 批量/完成 button)
          rather than in the batch bar below, because that bar has to carry the shelf action as
          well and four controls plus the count do not fit next to each other on a 320 px screen.
          Only visible in selection mode.
        -->
        <TextView
            android:id="@+id/local_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingLeft="10dip"
            android:paddingRight="10dip"
            android:paddingTop="4dip"
            android:paddingBottom="4dip"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:text="完成" />

        <TextView
            android:id="@+id/local_add"
            android:layout_width="40dip"
            android:layout_height="40dip"
            android:gravity="center"
            android:textSize="26sp"
            android:textColor="@color/accent"
            android:background="@color/accent_light"
            android:text="+" />
    </LinearLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="1dip"
        android:background="@color/divider" />

    <!--
      Batch-edit bar, same idea as the shelf's and the 书源 page's: a long press ticks rows and
      this bar acts on them. The extra action here is the shelf toggle (加入书架 / 移出书架):
      an imported file is NOT put on the 书架 by importing it, so this is the way across.
    -->
    <LinearLayout
        android:id="@+id/local_batch_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@color/accent_light"
        android:gravity="center_vertical"
        android:paddingLeft="14dip"
        android:paddingRight="8dip"
        android:paddingTop="7dip"
        android:paddingBottom="7dip">

        <TextView
            android:id="@+id/local_sel_info"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="已选 0 本" />

        <TextView
            android:id="@+id/btn_local_shelf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dip"
            android:paddingRight="8dip"
            android:paddingTop="4dip"
            android:paddingBottom="4dip"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:text="加入书架" />

        <TextView
            android:id="@+id/btn_local_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dip"
            android:paddingLeft="10dip"
            android:paddingRight="10dip"
            android:paddingTop="4dip"
            android:paddingBottom="4dip"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:text="全选" />

        <TextView
            android:id="@+id/btn_local_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dip"
            android:paddingLeft="10dip"
            android:paddingRight="10dip"
            android:paddingTop="4dip"
            android:paddingBottom="4dip"
            android:textSize="13sp"
            android:textColor="#FFC62828"
            android:text="删除" />
    </LinearLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="1dip"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1">

        <ListView
            android:id="@+id/local_list"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dip"
            android:cacheColorHint="#00000000"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/local_empty"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:paddingLeft="20dip"
            android:paddingRight="20dip"
            android:textSize="14sp"
            android:textColor="@color/text_hint"
            android:lineSpacingExtra="6dip"
            android:text="可以点击加号来添加本地图书\n\n支持 txt / epub / html" />
    </FrameLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="1dip"
        android:background="@color/divider" />

    <!-- shared bottom tab bar: identical ids in all three page layouts; see Ui.tabs -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="54dip"
        android:orientation="horizontal"
        android:background="@color/bar_bg">

        <LinearLayout
            android:id="@+id/tab_shelf"
            style="@style/TabItem">

            <View
                android:id="@+id/tab_shelf_mark"
                style="@style/TabMark" />

            <ImageView
                android:id="@+id/tab_shelf_icon"
                android:layout_width="22dip"
                android:layout_height="22dip"
                android:src="@drawable/tab_shelf_off" />

            <TextView
                android:id="@+id/tab_shelf_label"
                style="@style/TabLabel"
                android:text="书架" />
        </LinearLayout>

        <View style="@style/TabGap" />

        <LinearLayout
            android:id="@+id/tab_source"
            style="@style/TabItem">

            <View
                android:id="@+id/tab_source_mark"
                style="@style/TabMark" />

            <ImageView
                android:id="@+id/tab_source_icon"
                android:layout_width="22dip"
                android:layout_height="22dip"
                android:src="@drawable/tab_source_off" />

            <TextView
                android:id="@+id/tab_source_label"
                style="@style/TabLabel"
                android:text="书源" />
        </LinearLayout>

        <View style="@style/TabGap" />

        <LinearLayout
            android:id="@+id/tab_local"
            style="@style/TabItem">

            <View
                android:id="@+id/tab_local_mark"
                style="@style/TabMark" />

            <ImageView
                android:id="@+id/tab_local_icon"
                android:layout_width="22dip"
                android:layout_height="22dip"
                android:src="@drawable/tab_local_on" />

            <TextView
                android:id="@+id/tab_local_label"
                style="@style/TabLabel"
                android:text="本地导入" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
