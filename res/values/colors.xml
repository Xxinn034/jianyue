<?xml version="1.0" encoding="utf-8"?>
<!--
  Palette, modelled on 开源阅读's light theme: white surfaces, a restrained warm red
  accent, grey secondary text. API 1 has no Material components and no themes beyond
  the framework default, so the look is built from plain colours, spacing and type
  scale rather than widgets.
-->
<resources>
    <color name="bg">#FFF7F7F7</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="accent">#FFBF3B2E</color>
    <color name="accent_light">#FFFFECEA</color>
    <color name="divider">#FFE8E8E8</color>
    <color name="text_primary">#FF222222</color>
    <color name="text_secondary">#FF888888</color>
    <color name="text_hint">#FFAAAAAA</color>
    <color name="tag_bg">#FFF1F1F1</color>
    <color name="bar_bg">#FFFFFFFF</color>
    <color name="reading_bg">#FFF6F1E7</color>
    <color name="reading_text">#FF3A3226</color>
</resources>
