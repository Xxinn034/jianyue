# Copy this file to secrets.local.ps1 and fill in your release keystore.
# secrets.local.ps1 is gitignored and must never be committed.
#
# The keystore is the app's identity: every APK you publish has to be signed with the
# same one, otherwise Android refuses to install it over the previous version and users
# have to uninstall (losing their book sources, reading progress and imported books).
#
# On CI these values come from repository secrets instead (KEYSTORE_BASE64 is decoded
# to a file by the workflow first).

$env:JY_KEYSTORE      = 'G:\legado-api1\release.keystore'
$env:JY_KEYSTORE_PASS = 'PUT_THE_STORE_PASSWORD_HERE'
$env:JY_KEY_ALIAS     = 'jianyue'
$env:JY_KEY_PASS      = 'PUT_THE_KEY_PASSWORD_HERE'
